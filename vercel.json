{
  "outputDirectory": "site",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/deloit",
      "destination": "/deloitte",
      "permanent": false
    },
    {
      "source": "/deloitte/",
      "destination": "/deloitte",
      "permanent": false
    }
  ]
}
